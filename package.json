{
  "name": "azf-pdf-generator",
  "version": "2.0.2",
  "description": "",
  "main": "src/functions/*.js",
  "scripts": {
    "test": "biome check && node --test tests/**/*.test.js",
    "node:test": "node --test",
    "test:generate": "node --test ./tests/generate-document.test.js",
    "test:generateV2Func": "node --test ./tests/generate-document-v2.test.js",
    "test:generateV2": "node --test ./tests/lib/pdf-generate-v2/pdfgenerator.test.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "refresh": "rm -rf node_modules && rm package-lock.json && npm i",
    "start": "func start"
  },
  "author": "",
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "@vestfoldfylke/loglady": "^2.1.0",
    "@vtfk/sjablong": "^1.1.0",
    "ajv": "^8.20.0",
    "handlebars": "^4.7.10",
    "html-to-pdfmake": "^2.5.36",
    "jsdom": "^26.1.0",
    "lodash.merge": "4.6.2",
    "markdown-it": "^14.3.3",
    "markdown-it-front-matter": "^0.2.4",
    "pdfmake": "^0.2.23",
    "yaml-front-matter": "4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^25.9.9"
  }
}
